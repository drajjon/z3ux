local Screen = {
	WIDTH = 320,
	HEIGHT = 240,
	TILE_WIDTH = 8,
	TILE_HEIGHT = 8,
}
Screen.COLS = Screen.WIDTH / Screen.TILE_WIDTH
Screen.ROWS = Screen.HEIGHT / Screen.TILE_HEIGHT
Screen.LAST_COL = Screen.COLS - 1 -- 0-based
Screen.LAST_ROW = Screen.ROWS - 1
Screen.CELLS = Screen.COLS * Screen.ROWS

local layer = {} ---@type url[]

function init(self)
	msg.post("@render:", "set_size", { width = Screen.WIDTH, height = Screen.HEIGHT })
	msg.post("@render:", "set_scale_snap", { snap = true })

	for y = 0, Screen.LAST_ROW do
		for x = 0, Screen.LAST_COL do
			local spr_x = x * Screen.TILE_WIDTH
			local spr_y = y * Screen.TILE_HEIGHT
			local factory_url = msg.url('/stuff#tilefactory')
			local go_id = factory.create(factory_url, vmath.vector3(spr_x, spr_y, 0.0))
			if not go_id then
				error('out of sprites')
			end

			local sprite_url = msg.url(nil, go_id, 'tile')

			local i = x + y * Screen.COLS + 1
			layer[i] = sprite_url
		end
	end
end

function update(self, dt)
	for _, cell_url in pairs(layer) do
		go.set(cell_url, "cursor", math.random()) -- tile 1 thru 155 currently
		go.set(cell_url, "col0", vmath.vector4(math.random(), math.random(), math.random(), 1.0))
		go.set(cell_url, "col1", vmath.vector4(math.random(), math.random(), math.random(), 1.0))
	end
end

