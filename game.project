[bootstrap]
main_collection = /boot/boot.collectionc
render = /lowrez/render/lowrez.renderc

[script]
shared_state = 1

[display]
width = 640
height = 360
high_dpi = 1
update_frequency = 60

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = Z3UX
dependencies#0 = https://github.com/britzl/template-lowres/archive/master.zip

[input]
game_binding = /boot/game.input_bindingc

[sprite]
subpixels = 0
max_count = 32768

[factory]
max_count = 32768

[collection]
max_instances = 32768

