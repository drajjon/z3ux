{
	"Module require": {
		"prefix": "req",
		"body": "local ${1:Class} = require('${2:.${1/(.*)/${1:/downcase}/}}')"
	},
	"Class method": {
		"prefix": "fn",
		"body": [
			"function ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}:$1($2)",
			"\t$0",
			"end",
		]
	},
	"Module method": {
		"prefix": "fm",
		"body": [
			"function ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}.$1($2)",
			"\t$0",
			"end",
		]
	},
	"Section header": {
		"prefix": "head",
		"body": [
			"-----------------------------------------------------------------------------------------",
			"-- $0",
			"-----------------------------------------------------------------------------------------",
		]
	},
	"Class file template": {
		"prefix": "class",
		"body": [
			"-----------------------------------------------------------------------------------------",
			"-- $0",
			"-----------------------------------------------------------------------------------------",
			"",
			"-----------------------------------------------------------------------------------------",
			"-- Definition and construction",
			"-----------------------------------------------------------------------------------------",
			"---@class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Proto",
			"",
			"---@class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}",
			"local ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} = {}",
			"local meta_${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} = { __index = ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} }",
			"",
			"---@class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Class",
			"local ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Class = {}",
			"",
			"---@param opts ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Proto?",
			"---@return ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}",
			"function ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}Class.new(opts)",
			"local self = setmetatable(opts or {}, meta_${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}) --[[@as ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}]]",
			"\treturn self",
			"end",
			"",
			"-----------------------------------------------------------------------------------------",
			"-- Class methods",
			"-----------------------------------------------------------------------------------------",
			"",
			"function ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}:do_something()",
			"\t",
			"end",
			"",
			"return ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}"
		]
	},
	"Test file template": {
		"scope": "lua",
		"prefix": "testfile",
		"include": [
			"**/test/*.lua",
			"*test*.lua"
		],
		"body": [
			"-----------------------------------------------------------------------------------------",
			"--",
			"-- Tests: $1",
			"--",
			"-----------------------------------------------------------------------------------------",
			//"---@diagnostic disable: no-unknown",
			//"---@diagnostic disable: need-check-nil",
			"",
			"local ${1:${TM_FILENAME_BASE/(test_)?(.*)/${2:/pascalcase}/}} = require('${2:pkg.class}')",
			//"local error = require('core.error')",
			"local assert = require('test.assert')",
			"",
			"return function()",
			"    context('$1', function()",
			"        before(function()",
			"        end)",
			"",
			"        after(function()",
			"        end)",
			"",
			"        test('basic $1 test', function()",
			"            $0",
			"        end)",
			"    end) -- $1",
			"end"
		]
	},
	"Test": {
		"scope": "lua",
		"prefix": "tst",
		"include": [
			"**/test/*.lua",
			"*test*.lua"
		],
		"body": [
			"test('$1', function()",
			"    $0",
			"end)",
		]
	},
	// Place your Z3UX workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
